<a:UiPage x:Class="KGallery.Pages.About_Page.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KGallery.Pages.About_Page"
      xmlns:a="clr-namespace:KGallery.Abstractions"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:Background="{ui:ThemeResource}"
      Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
      d:DataContext="{d:DesignInstance Type=local:AboutPageViewModel}"
      mc:Ignorable="d" 
      ui:NavigationView.HeaderContent="About"
      d:DesignHeight="720" d:DesignWidth="1080"
      Title="AboutPage">
    <Grid Margin="20,20,12,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Image32" Filled="True" FontSize="98" Margin="0,0,20,0"/>

            <StackPanel>
                <ui:TextBlock Text="KGallery" FontTypography="TitleLarge"/>
                <ui:TextBlock FontTypography="Subtitle" Text="Image viewing application"/>
                <ui:TextBlock FontTypography="Caption">
                    <Run Text="Version : "/>
                    <Run Text="{Binding Version, Mode=OneTime}"/>
                </ui:TextBlock>
            </StackPanel>        
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <ui:TextBlock FontTypography="Subtitle" Text="Project"/>
            <ui:TextBlock Text="Main information about the KGallery" Appearance="Secondary"/>
            <ui:CardAction Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/KonTuk9" Icon="{ui:SymbolIcon Symbol=Person16}" Content="Author : KonTuk9" Margin="0,8,0,0"/>
            <ui:CardAction Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/KonTuk9/KGallery" Icon="{ui:SymbolIcon Symbol=Code16}" Margin="0,8,0,0" Content="Project source"/>

            <Separator Margin="0,8,0,0"/>

            <ui:TextBlock FontTypography="Subtitle" Text="Tools" Margin="0,8,0,0"/>
            <ui:TextBlock Text="Extensions sources used for this application" Appearance="Secondary"/>
            <UniformGrid Columns="2">
                <ui:CardAction Command="{Binding OpenLinkCommand}" CommandParameter="https://www.nuget.org/packages/microsoft.extensions.dependencyinjection/" Icon="{ui:SymbolIcon Symbol=Connected16}" Margin="0,8,4,0" Content="Microsoft dependency injection"/>
                <ui:CardAction Command="{Binding OpenLinkCommand}" CommandParameter="https://www.nuget.org/packages/microsoft.entityframeworkcore/" Icon="{ui:SymbolIcon Symbol=DatabasePlugConnected20}" Margin="4,8,0,0" Content="Entity Framework Core SQLite"/>
                <ui:CardAction Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/lepoco/wpfui"  Icon="{ui:SymbolIcon Symbol=Desktop16}" Margin="0,8,4,0" Content="WPF-UI by lepo"/>
                <ui:CardAction Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/reactivemarbles/DynamicData" Icon="{ui:SymbolIcon Symbol=DatabaseStack16}" Margin="4,8,0,0" Content="Dynamic data"/>
                <ui:CardAction Command="{Binding OpenLinkCommand}" CommandParameter="https://www.nuget.org/packages/CommunityToolkit.Mvvm" Icon="{ui:SymbolIcon Symbol=Toolbox16}" Margin="0,8,4,0" Content="Community toolkit MVVM"/>
                <ui:CardAction Command="{Binding OpenLinkCommand}" CommandParameter="https://www.newtonsoft.com/json" Icon="{ui:SymbolIcon Symbol=DocumentLink16}" Margin="4,8,0,0" Content="Newtonsoft JSON"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</a:UiPage>

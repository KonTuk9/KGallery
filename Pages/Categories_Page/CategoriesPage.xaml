<a:UiPage x:Class="KGallery.Pages.Categories_Page.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ci="clr-namespace:KGallery.Pages.Category_Images_Page"
      xmlns:local="clr-namespace:KGallery.Pages.Categories_Page"
      mc:Ignorable="d" 
      ScrollViewer.CanContentScroll="False"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:KGallery.Controls"
      xmlns:a="clr-namespace:KGallery.Abstractions"
        d:Background="{ui:ThemeResource}"
        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
        d:DataContext="{d:DesignInstance Type=local:CategoriesPageViewModel}"
        ui:NavigationView.HeaderContent="Categories"
      d:DesignHeight="720" d:DesignWidth="1080"
      Title="CategoriesPage">
    <Grid Margin="20,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Height="36" Margin="0,0,0,12">
            <ui:Button Command="{Binding AddCategoryCommand}" Icon="{ui:SymbolIcon Symbol=Add16}" Content="Add new category" VerticalAlignment="Stretch"/>
            <ui:TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Icon="{ui:SymbolIcon Symbol=Search16}" VerticalAlignment="Stretch" PlaceholderText="Search category..." Width="200" Margin="8,0,0,0"/>
            <ComboBox Width="200" VerticalAlignment="Stretch" Margin="8,0,0,0" SelectedIndex="{Binding SelectedSorting}">
                <ComboBoxItem Content="Favourites" IsSelected="True"/>
                <ComboBoxItem Content="Sort by images count"/>
                <ComboBoxItem Content="Sort by name"/>
                <ComboBoxItem Content="Sort by date"/>
            </ComboBox>
            <ToggleButton x:Name="toggleButton" Style="{StaticResource SelectToggleButton}" IsChecked="{Binding IsSelectionEnabled}" Width="100" VerticalAlignment="Stretch" Margin="8,0,0,0"/>
            <ui:DropDownButton Visibility="{Binding IsChecked, Converter={StaticResource BooleanToVisibilityConverter}, ElementName=toggleButton}" Content="Selection edit" Icon="{ui:SymbolIcon Symbol=Edit16}" VerticalAlignment="Stretch" Margin="8,0,0,0">
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <ui:MenuItem Header="Select all" Command="{StaticResource ListBoxSelectAllCommand}" CommandParameter="{x:Reference categoriesItemsControl}" Icon="{ui:SymbolIcon Symbol=TaskListRtl24}" StaysOpenOnClick="True"/>
                        <ui:MenuItem Header="Delete" CommandParameter="{Binding SelectedItems, Source={x:Reference categoriesItemsControl}}" Icon="{ui:SymbolIcon Symbol=Delete16}"/>
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </StackPanel>

        <ListBox IsTabStop="False" Grid.Row="1" x:Name="categoriesItemsControl" VirtualizingPanel.CacheLengthUnit="Item"
    ItemsSource="{Binding Categories, Mode=OneWay}" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.CacheLength="0" SelectionMode="{Binding SelectionMode}">
            <ListBox.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Border.CornerRadius" Value="4"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel x:Name="categoryItem" Width="180" Margin="2,2,2,4">
                        <Grid Background="{ui:ThemeResource ControlStrokeColorDefaultBrush}">
                            <ui:Image Source="{Binding Thumbnail.Data, Mode=OneWay}" Height="180" Stretch="UniformToFill"/>
                            <Border Visibility="{Binding DataContext.DisableOnSelectionVisibility, RelativeSource={RelativeSource AncestorType=Page}}" Opacity="0.33" MouseLeftButtonUp="CategoryItemClick" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <ui:MenuItem Icon="{ui:SymbolIcon Symbol=Diversity24}" Header="Overview" Command="{Binding PlacementTarget.Tag.OpenCategoryOverviewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        <ui:MenuItem Icon="{ui:SymbolIcon Symbol=Edit16}" Header="Rename" Command="{Binding PlacementTarget.Tag.RenameCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        <ui:MenuItem Icon="{ui:SymbolIcon Symbol=Delete16}" Header="Delete" Command="{Binding PlacementTarget.Tag.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
                                <ToggleButton Padding="8" IsChecked="{Binding Favourited, Mode=TwoWay}" Command="{Binding DataContext.ToggleFavouriteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                            <Setter Property="Content" Value="{ui:SymbolIcon Symbol=Star16}"/>

                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="Content" Value="{ui:SymbolIcon Symbol=Star16, Filled=True}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <ui:Button Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Foreground="White" Appearance="Danger" Padding="8" Icon="{ui:SymbolIcon Symbol=Delete16}" Margin="0,4,0,0"/>
                                <ui:Button Command="{Binding DataContext.RenameCategoryCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Foreground="White" Appearance="Transparent" Padding="8" Icon="{ui:SymbolIcon Symbol=Edit16}" Margin="0,4,0,0"/>

                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="{Binding DataContext.DisableOnSelectionVisibility, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            </StackPanel>
                        </Grid>

                        <ui:TextBlock Text="{Binding Name, Mode=OneWay}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis"/>

                        <ui:TextBlock Margin="2" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                            <Run Text="Images :"/>
                            <Run Text="{Binding ImagesCount, Mode=OneWay}"/>
                        </ui:TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <c:VirtualizingUiWrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</a:UiPage>

<UserControl x:Class="KGallery.Controls.EditImageCategoriesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KGallery.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             d:DesignHeight="720" d:DesignWidth="1080">
    <Grid>
        <Border Background="Black" Opacity="0.25"/>

        <Border Background="{ui:ThemeResource}" CornerRadius="4.5" Width="700" Height="500">
            <ui:Card VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock Text="Edit image" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,12"/>

                    <ui:Image x:Name="image" Grid.Row="1" Grid.RowSpan="2" CornerRadius="4" Source="{Binding ImagePath}"/>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="20,0,0,0">
                        <Label Content="Search category"/>
                        <ui:TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Enter category name..." Icon="{ui:SymbolIcon Symbol=Search16}"/>
                    </StackPanel>

                    <ui:Card IsTabStop="False" Grid.Row="2" Grid.Column="1" Margin="20,8,0,0" Padding="0,4,0,4" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
                        <ui:VirtualizingItemsControl ItemsSource="{Binding Categories}" AlternationCount="2"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ui:VirtualizingItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="item">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <ui:TextBlock Grid.Column="1" VerticalAlignment="Center">
                                            <Run Text="Images :"/>
                                            <Run Text="{Binding ImagesCount, Mode=OneWay}"/>
                                        </ui:TextBlock>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="2" Margin="0,2,0,0"/>
                                        <Separator Grid.ColumnSpan="3" VerticalAlignment="Bottom"/>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                            <Setter TargetName="item" Property="Background" Value="{ui:ThemeResource ControlStrokeColorDefaultBrush}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ui:VirtualizingItemsControl.ItemTemplate>

                            <ui:VirtualizingItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ui:VirtualizingItemsControl.ItemsPanel>
                        </ui:VirtualizingItemsControl>
                    </ui:Card>
                </Grid>

                <ui:Card.Footer>
                    <DockPanel>
                        <ui:Button Command="{Binding DeleteCommand}" Width="100" Content="Delete" Icon="{ui:SymbolIcon Symbol=Delete16}" Foreground="White" Appearance="Danger"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Foreground="White" Command="{Binding SubmitCommand}" Content="Save changes" Margin="0,0,8,0" Appearance="Primary"/>
                            <ui:Button Command="{Binding CloseCommand}" Width="100" Content="Cancel"/>
                        </StackPanel>
                    </DockPanel>
                </ui:Card.Footer>
            </ui:Card>

            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="0" Opacity="0.4" ShadowDepth="0" Color="#202020" />
            </Border.Effect>
        </Border>
    </Grid>
</UserControl>
